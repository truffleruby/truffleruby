# Merges a GitHub Pull Request locally, see CONTRIBUTING.md.
# Usage: tool/merge PR_NUMBER_OR_URL

require 'json'

number = ARGV[0].to_s[/\d+\z/] or abort "Usage: #{$0} PR_NUMBER_OR_URL"
json = `gh pr view #{number} --repo truffleruby/truffleruby --json title`
raise "gh pr view #{number} failed" unless $?.success?
title = JSON.parse(json).fetch('title')

def sh(*command)
  system(*command, exception: true)
end

sh 'git', 'checkout', 'master'
sh 'git', 'pull'
sh 'git', 'fetch', 'https://github.com/truffleruby/truffleruby.git', "refs/pull/#{number}/head"
sh 'git', 'merge', '--no-ff', '-m', "#{title} (##{number})", 'FETCH_HEAD'
sh 'git', 'push'
